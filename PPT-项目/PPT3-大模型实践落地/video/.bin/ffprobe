#!/usr/bin/env python3
"""
ffprobe-compatible shim wrapping a static ffmpeg binary.
Handles all invocation patterns used by HyperFrames:
  - duration:     -v error -show_entries format=duration -of default=... FILE
  - codec:        -v error -select_streams v:0 -show_entries stream=codec_name -of json FILE
  - frames fast:  -v error -select_streams v:0 -show_entries stream=nb_frames,r_frame_rate -of json FILE
  - frames slow:  -v error -select_streams v:0 -count_packets -show_entries stream=nb_read_packets,r_frame_rate -of json FILE
  - streams:      -v quiet -print_format json -show_streams FILE
Robust against ffmpeg 7.1 stream headers like:  Stream #0:0[0x1](und): Video: h264 ...
"""
import os
import re
import sys
import json
import subprocess

FFMPEG = os.environ.get("HFSHIM_FFMPEG") or os.path.join(
    os.path.dirname(os.path.abspath(__file__)), "ffmpeg"
)
if os.path.islink(FFMPEG) and not os.path.exists(FFMPEG):
    FFMPEG = os.path.realpath(FFMPEG)
if not os.path.isfile(FFMPEG):
    for d in os.environ.get("PATH", "").split(os.pathsep):
        cand = os.path.join(d, "ffmpeg")
        if os.path.isfile(cand):
            FFMPEG = cand
            break

_stream_re = re.compile(
    r"Stream\s+#\d+:\d+[^:]*:\s*(Video|Audio|Subtitle|Data|Attachment):\s*(\w+)"
)


def parse_ffmpeg_info(path):
    """Run `ffmpeg -i path`; return (duration, streams[]) parsed from stderr."""
    try:
        proc = subprocess.run(
            [FFMPEG, "-hide_banner", "-i", path],
            capture_output=True, text=True, timeout=60,
        )
    except Exception:
        return None, []
    err = proc.stderr or ""
    duration = None
    m = re.search(r"Duration:\s*(\d+):(\d+):(\d+)[,.](\d+)", err)
    if m:
        duration = (
            int(m.group(1)) * 3600 + int(m.group(2)) * 60 + int(m.group(3))
            + float("0." + m.group(4))
        )
    streams = []
    for sm in _stream_re.finditer(err):
        codec_type = sm.group(1).lower()
        codec_name = sm.group(2).lower()
        tail = err[sm.end(): sm.end() + 260]
        stream = {"codec_type": codec_type, "codec_name": codec_name}
        sr = re.search(r"(\d+)\s*Hz", tail)
        if sr:
            stream["sample_rate"] = sr.group(1)
        ch = re.search(r"mono|stereo|(\d+)\s*channels", tail)
        if ch:
            raw = ch.group(0)
            stream["channels"] = 1 if raw == "mono" else (2 if raw == "stereo" else int(ch.group(1)))
        fps_m = re.search(r"(\d+(?:\.\d+)?)\s*fps", tail)
        if fps_m and codec_type == "video":
            fps = fps_m.group(1)
            stream["_fps"] = fps
            stream["r_frame_rate"] = ("%d/1" % round(float(fps))) if "." not in fps else (
                "%d/1" % round(float(fps)))
        dim = re.search(r"(\d{2,5})x(\d{2,5})", tail)
        if dim and codec_type == "video":
            stream["width"] = int(dim.group(1))
            stream["height"] = int(dim.group(2))
        streams.append(stream)
    return duration, streams


def main():
    args = sys.argv[1:]
    file_path = None
    for a in reversed(args):
        if not a.startswith("-") and os.path.exists(a):
            file_path = a
            break
    if file_path is None and args and not args[-1].startswith("-"):
        file_path = args[-1]

    joined = " ".join(args)
    fmt = "default"
    for i, a in enumerate(args):
        if a in ("-of", "-print_format") and i + 1 < len(args):
            fmt = args[i + 1]

    duration, streams = (None, [])
    if file_path and os.path.exists(file_path):
        duration, streams = parse_ffmpeg_info(file_path)

    # --- duration ---
    if "format=duration" in joined:
        print(("%s" % (0.0 if duration is None else duration)))
        return 0

    # --- frame-count probes (audioPadTrim fast + slow) ---
    select_type = None
    if "-select_streams" in args:
        idx = args.index("-select_streams")
        select_type = args[idx + 1] if idx + 1 < len(args) else None

    def pick(sel):
        if sel and sel.startswith("v"):
            vs = [s for s in streams if s.get("codec_type") == "video"]
            return vs[:1]
        if sel and sel.startswith("a"):
            as_ = [s for s in streams if s.get("codec_type") == "audio"]
            return as_[:1]
        return streams

    if "nb_read_packets" in joined or "nb_frames" in joined:
        chosen = pick(select_type)
        out = []
        for s in chosen:
            obj = {}
            if "r_frame_rate" in s:
                obj["r_frame_rate"] = s["r_frame_rate"]
            if "nb_frames" in joined:
                # fast path: nb_frames not trivially known; leave absent so it
                # falls through to the slow (nb_read_packets) probe.
                pass
            if "nb_read_packets" in joined and duration and s.get("_fps"):
                obj["nb_read_packets"] = str(round(duration * float(s["_fps"])))
            elif "nb_read_packets" in joined and duration:
                obj["nb_read_packets"] = str(round(duration * 30))
            out.append(obj)
        print(json.dumps({"streams": out}))
        return 0

    # --- codec_name (HEVC detection) ---
    if "stream=codec_name" in joined:
        chosen = pick(select_type)
        print(json.dumps({"streams": [{"codec_name": s.get("codec_name", "")} for s in chosen]}))
        return 0

    # --- show_format / show_streams (individually or combined) ---
    want_streams = "-show_streams" in args
    want_format = "-show_format" in args
    if want_streams or want_format:
        result = {}
        if want_streams:
            result["streams"] = streams
        if want_format:
            result["format"] = {"duration": str(duration)} if duration is not None else {}
        print(json.dumps(result))
        return 0

    # --- generic ---
    result = {}
    if streams:
        result["streams"] = streams
    if duration is not None:
        result["format"] = {"duration": str(duration)}
    print(json.dumps(result))
    return 0


if __name__ == "__main__":
    sys.exit(main())
